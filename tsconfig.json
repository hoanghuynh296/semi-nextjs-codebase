{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@semi/ui": [
        "./src/index.ts"
      ],
      "@semi/ui/styles": [
        "./styles/index.ts"
      ],
      "@semi/ui/styles.json": [
        "./tokens/styles.json"
      ]
    }
  },
  "include": [
    ".next/dev/types/**/*.ts",
    ".next/types/**/*.ts",
    "app",
    "examples",
    "site",
    "src",
    "styles"
  ],
  "exclude": [
    "node_modules"
  ]
}
