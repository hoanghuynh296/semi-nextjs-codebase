{
  "name": "@semi/ui",
  "version": "0.6.0",
  "private": true,
  "description": "Semi Design System: tokens, React components, class constants, lint and agent plugin for Next.js 16 + React 19 + Tailwind 4.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoanghuynh296/semi-nextjs-codebase.git"
  },
  "exports": {
    ".": "./src/index.ts",
    "./styles": "./styles/index.ts",
    "./tokens.css": "./tokens/tokens.css",
    "./base.css": "./styles/base.css",
    "./tokens.json": "./tokens/tokens.json",
    "./package.json": "./package.json",
    "./components.json": "./components.json"
  },
  "bin": {
    "semi-lint": "lint/semi-lint.mjs"
  },
  "files": [
    "src",
    "styles",
    "tokens",
    "lint",
    "docs",
    "CHANGELOG.md",
    "components.json"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build:tokens": "node scripts/build-tokens.mjs",
    "check:tokens": "node scripts/build-tokens.mjs --check",
    "sync:vendor": "node scripts/sync-vendor.mjs",
    "check:vendor": "node scripts/sync-vendor.mjs --check",
    "bump": "node scripts/bump-version.mjs",
    "check:version": "node scripts/bump-version.mjs --check",
    "build:manifest": "node scripts/build-manifest.mjs",
    "check:manifest": "node scripts/build-manifest.mjs --check",
    "test": "node --test lint/test/*.test.mjs",
    "test:ui": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "node lint/semi-lint.mjs",
    "check": "npm run check:tokens && npm run check:vendor && npm run check:version && npm run check:manifest && npm run typecheck && npm run lint && npm test",
    "build:storybook": "next build",
    "dev": "next dev"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "next": "^16",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
