{
  "$schema_note": "Single source of the Semi tokens. Edit here, then `node scripts/build-tokens.mjs` → tokens/tokens.css. Keys are CSS custom properties without the leading --; groups only organise the file.",
  "font": {
    "font-mono": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, monospace"
  },
  "type": {
    "text-caption": "11px",
    "text-label": "12px",
    "text-ui": "14px",
    "text-ui-lg": "15px",
    "text-title": "15px",
    "text-title-lg": "16px",
    "text-figure": {
      "value": "18px",
      "note": "Numeric figures: KPI values, keypad digits, totals (text-figure sm:text-heading in KpiCard)"
    },
    "text-heading-sm": "20px",
    "text-heading": "22px",
    "text-heading-lg": "24px",
    "text-display": "26px",
    "text-overline": {
      "value": "11px",
      "note": "Section labels only (C-032): a sidebar or drawer group, a command palette group, a mega menu column. Uppercase, tracked, semibold; never a button, field label or title",
      "letterSpacing": "0.06em",
      "fontWeight": "600",
      "transform": "uppercase"
    },
    "text-caption--line-height": {
      "value": "1.5",
      "note": "Paired line height: text-* sets it, leading-* still overrides"
    },
    "text-label--line-height": "1.5",
    "text-ui--line-height": "1.5",
    "text-ui-lg--line-height": "1.5",
    "text-title--line-height": "1.5",
    "text-title-lg--line-height": "1.5",
    "text-figure--line-height": "1.25",
    "text-heading-sm--line-height": "1.25",
    "text-heading--line-height": "1.25",
    "text-heading-lg--line-height": "1.25",
    "text-display--line-height": "1.25",
    "text-overline--line-height": "1.5",
    "text-kpi": {
      "value": "var(--text-figure)",
      "note": "Deprecated (0.30.0): renamed text-figure; the migration rewrites it",
      "deprecated": true
    },
    "text-kpi--line-height": {
      "value": "var(--text-figure--line-height)",
      "deprecated": true
    }
  },
  "product": {
    "$note": "Choices of a product (an app), not of its brand: one brand has a dense dashboard and a roomy store. Set on <html> (data-density, data-type-scale) and in semi-lint.json; unset = regular / even.",
    "density": {
      "compact": {
        "spacing": "0.225rem",
        "note": "Tools used all day: more on a screen (body text 13px)",
        "sizes": {
          "text-ui": "13px",
          "text-ui-lg": "14px"
        }
      },
      "regular": {
        "spacing": "0.25rem",
        "note": "Semi's default (body text 14px)"
      },
      "airy": {
        "spacing": "0.2875rem",
        "note": "Consumer, store, onboarding: one thing per screen, room around it"
      }
    },
    "typeScale": {
      "even": {
        "note": "Titles a little larger than body text (default)"
      },
      "contrast": {
        "note": "Marketing, store, editorial: big titles and figures",
        "sizes": {
          "text-figure": "22px",
          "text-heading-sm": "22px",
          "text-heading": "26px",
          "text-heading-lg": "30px",
          "text-display": "34px"
        }
      }
    }
  },
  "space": {
    "$note": "Semantic spacing: every value is a multiple of the density unit (--semi-spacing), so data-density scales it. Utilities: p-card, gap-stack …",
    "spacing-card": {
      "value": "calc(var(--semi-spacing) * 4)",
      "note": "Padding inside a card, popover, list panel (p-card, 16px regular)"
    },
    "spacing-panel": {
      "value": "calc(var(--semi-spacing) * 6)",
      "note": "Padding of a hero, page panel or roomy card from sm (sm:p-panel, 24px regular)"
    },
    "spacing-stack": {
      "value": "calc(var(--semi-spacing) * 3)",
      "note": "Gap between items inside a card or form (gap-stack, 12px regular)"
    },
    "spacing-group": {
      "value": "calc(var(--semi-spacing) * 4)",
      "note": "Gap between cards in a grid or list (gap-group, 16px regular)"
    },
    "spacing-section": {
      "value": "calc(var(--semi-spacing) * 6)",
      "note": "Gap between page sections (gap-section, 24px regular)"
    }
  },
  "brand": {
    "color-primary": "#00AE42",
    "color-primary-50": "#E6F7EC",
    "color-primary-100": "#C2EBD1",
    "color-primary-200": "#8FDBAC",
    "color-primary-300": "#52C97F",
    "color-primary-400": "#1FBC5C",
    "color-primary-500": "#00AE42",
    "color-primary-600": "#009038",
    "color-primary-700": "#007230",
    "color-primary-800": "#005A27",
    "color-primary-900": "#00441D"
  },
  "status": {
    "color-emerald-50": "#F0FAF4",
    "color-emerald-100": "#DCF5E5",
    "color-emerald-200": "#B8ECCB",
    "color-emerald-300": "#86DEAA",
    "color-emerald-400": "#34B76C",
    "color-emerald-500": "#28A25A",
    "color-emerald-600": "#208549",
    "color-emerald-700": "#186537",
    "color-emerald-800": "#13502C",
    "color-emerald-900": "#0E3C21",
    "color-emerald-950": "#022c22"
  },
  "semantic": {
    "color-canvas": {
      "dark": "#0f1011",
      "light": "#eff3f7",
      "note": "Nền ứng dụng ngoài cùng"
    },
    "color-app": {
      "dark": "#151619",
      "light": "#f7f9fb",
      "note": "Khung bề mặt màn hình chính"
    },
    "color-panel": {
      "dark": "#191b1f",
      "light": "#ffffff",
      "note": "Thẻ Bento Card, Sidebar, Modal"
    },
    "color-field": {
      "dark": "#202328",
      "light": "#eff3f7",
      "note": "Nền ô nhập liệu, header bảng"
    },
    "color-raised": {
      "dark": "#2b2e34",
      "light": "#e1e7ef",
      "note": "Hover / track fills on top of field"
    },
    "color-panel-0": {
      "dark": "var(--semi-canvas)",
      "light": "var(--semi-canvas)",
      "note": "Surface step 0 (C-030): the outer canvas. Same value as canvas (canvas is its alias)"
    },
    "color-panel-1": {
      "dark": "color-mix(in oklab, var(--semi-canvas), var(--semi-app))",
      "light": "color-mix(in oklab, var(--semi-canvas), var(--semi-app))",
      "note": "Surface step 1: halfway between canvas and app"
    },
    "color-panel-2": {
      "dark": "var(--semi-app)",
      "light": "var(--semi-app)",
      "note": "Surface step 2: main content. Same value as app (app is its alias)"
    },
    "color-panel-3": {
      "dark": "color-mix(in oklab, var(--semi-app), var(--semi-panel))",
      "light": "color-mix(in oklab, var(--semi-app), var(--semi-panel))",
      "note": "Surface step 3: halfway between app and panel"
    },
    "color-panel-4": {
      "dark": "var(--semi-panel)",
      "light": "var(--semi-panel)",
      "note": "Surface step 4: sidebar, modal, popover. Same value as panel (panel is its alias)"
    },
    "color-card": {
      "dark": "color-mix(in oklab, var(--semi-panel) 95%, var(--semi-text-contrast))",
      "light": "color-mix(in oklab, var(--semi-app) 95%, var(--semi-text-contrast))",
      "utility": "bg",
      "sets": { "accent-subtle": "var(--semi-accent-subtle-card)", "accent-subtle-hover": "var(--semi-accent-subtle-hover-card)" },
      "note": "Content card (CARD): no border, separated by tone. Dark one step above panel (5%); light recessed below app (5%)"
    },
    "color-card-field": {
      "dark": "color-mix(in oklab, var(--semi-card) 95%, var(--semi-text-contrast))",
      "light": "color-mix(in oklab, var(--semi-card) 97%, var(--semi-text-contrast))",
      "utility": "bg",
      "note": "Field, tile or table head inside a card: one step off the card"
    },
    "color-tint": {
      "dark": "color-mix(in oklab, var(--semi-text-contrast) 7%, transparent)",
      "light": "color-mix(in oklab, var(--semi-text-contrast) 5%, transparent)",
      "note": "Translucent fill of a secondary button (BTN_SECONDARY): reads on every surface, no border"
    },
    "color-tint-hover": {
      "dark": "color-mix(in oklab, var(--semi-text-contrast) 11%, transparent)",
      "light": "color-mix(in oklab, var(--semi-text-contrast) 9%, transparent)",
      "note": "Hover of tint"
    },
    "color-inverted": {
      "dark": "color-mix(in oklab, var(--semi-text-contrast) 96%, var(--semi-canvas))",
      "light": "var(--semi-text-contrast)",
      "note": "Neutral solid fill, the opposite of the page (near-white in dark, near-black in light): the main button of a brand with primaryStyle inverted"
    },
    "color-inverted-hover": {
      "dark": "var(--semi-text-contrast)",
      "light": "color-mix(in oklab, var(--semi-text-contrast) 85%, var(--semi-panel))",
      "note": "Hover of inverted"
    },
    "color-on-inverted": {
      "dark": "var(--semi-canvas)",
      "light": "var(--semi-panel)",
      "note": "Text / icon on bg-inverted"
    },
    "color-text-contrast": {
      "dark": "#ffffff",
      "light": "#0f172a",
      "alias": "color-contrast",
      "note": "Tiêu đề, chữ độ tương phản cao"
    },
    "color-text-body": {
      "dark": "#d1d5db",
      "light": "#334155",
      "alias": "color-body",
      "note": "Nội dung văn bản chính"
    },
    "color-text-muted": {
      "dark": "#9ba1aa",
      "light": "#5b6779",
      "alias": "color-muted",
      "note": "Nhãn phụ, placeholder, gợi ý"
    },
    "color-line": {
      "dark": "rgba(255, 255, 255, 0.12)",
      "light": "rgba(0, 0, 0, 0.08)",
      "note": "Đường viền card, bảng, khung"
    },
    "color-line-hover": {
      "dark": "rgba(255, 255, 255, 0.2)",
      "light": "rgba(0, 0, 0, 0.16)",
      "note": "Đường viền khi hover"
    },
    "color-control-line": {
      "dark": "color-mix(in oklab, var(--semi-text-muted) 65%, transparent)",
      "light": "color-mix(in oklab, var(--semi-text-muted) 80%, transparent)",
      "note": "Boundary of an input you type in or tick (text field, select field, checkbox, radio): ≥ 3:1 on every surface (WCAG 1.4.11). Cards and tables keep line"
    },
    "color-control-line-hover": {
      "dark": "var(--semi-text-muted)",
      "light": "var(--semi-text-muted)",
      "note": "Hover of control-line"
    },
    "color-divider": {
      "dark": "rgba(255, 255, 255, 0.05)",
      "light": "rgba(0, 0, 0, 0.05)",
      "note": "Đường phân cách nhẹ giữa các hàng"
    },
    "color-accent": {
      "dark": "var(--color-primary-500)",
      "light": "var(--color-primary-700)",
      "note": "Solid primary fill (BTN_PRIMARY, active marks). Pair with on-accent"
    },
    "color-accent-hover": {
      "dark": "var(--color-primary-400)",
      "light": "var(--color-primary-800)",
      "note": "Hover of the solid primary fill"
    },
    "color-on-accent": {
      "dark": "#0c0d0e",
      "light": "#ffffff",
      "note": "Text/icon on bg-accent (WCAG AA ≥ 4.5:1 in both themes)"
    },
    "color-action": {
      "dark": "var(--semi-accent)",
      "light": "var(--semi-accent)",
      "note": "Fill of the main button (BTN_PRIMARY). The accent by default; a brand with primaryStyle inverted points it at inverted"
    },
    "color-action-hover": {
      "dark": "var(--semi-accent-hover)",
      "light": "var(--semi-accent-hover)",
      "note": "Hover of action"
    },
    "color-on-action": {
      "dark": "var(--semi-on-accent)",
      "light": "var(--semi-on-accent)",
      "note": "Text / icon on bg-action"
    },
    "color-accent-fg": {
      "dark": "var(--color-primary-400)",
      "light": "var(--color-primary-800)",
      "note": "Primary-coloured text/icons on surfaces (links, check marks, active tab); light 800 so it reads on accent-subtle over the recessed card (C-030)"
    },
    "color-focus": {
      "dark": "var(--semi-accent-fg)",
      "light": "var(--semi-accent-fg)",
      "note": "Focus ring (ring-focus) and focused field border: follows accent-fg, so it reaches 3:1 on every surface"
    },
    "color-accent-subtle": {
      "dark": "color-mix(in oklab, var(--semi-accent-fg) 14%, transparent)",
      "light": "color-mix(in oklab, var(--semi-accent-fg) 11%, var(--semi-panel))",
      "note": "Selected / active tint behind text-accent-fg, text-body or text-muted (selected option, active tab pill, IconTile). Light is opaque, mixed into the panel (#123); inside a card (bg-card) it is color-accent-subtle-card"
    },
    "color-accent-subtle-card": {
      "dark": "color-mix(in oklab, var(--semi-accent-fg) 14%, transparent)",
      "light": "color-mix(in oklab, var(--semi-accent-fg) 2%, var(--semi-panel))",
      "private": true,
      "note": "accent-subtle inside a card (bg-card sets --semi-accent-subtle to it). Light: the recessed card leaves no room for a darker fill that keeps text-muted at 4.5:1, so the selected row is lifted to the panel's tone (#123)"
    },
    "color-accent-subtle-hover": {
      "dark": "color-mix(in oklab, var(--semi-accent-fg) 19%, transparent)",
      "light": "color-mix(in oklab, var(--semi-accent-fg) 13.5%, var(--semi-panel))",
      "note": "Hover of an accent-subtle surface (light: mixed into the panel like accent-subtle). text-muted reads 4.5:1 on it too (#123)"
    },
    "color-accent-subtle-hover-card": {
      "dark": "color-mix(in oklab, var(--semi-accent-fg) 20%, var(--semi-panel))",
      "light": "color-mix(in oklab, var(--semi-accent-fg) 6%, var(--semi-panel))",
      "private": true,
      "note": "accent-subtle-hover inside a card (bg-card sets --semi-accent-subtle-hover to it): light a step below the lifted selection; dark a tinted step below the card, since a lighter one would cost text-muted its 4.5:1 (#123)"
    },
    "color-accent-line": {
      "dark": "color-mix(in oklab, var(--semi-accent-fg) 40%, transparent)",
      "light": "color-mix(in oklab, var(--semi-accent-fg) 40%, transparent)",
      "note": "Border of a selected / active item (selected card, today in a calendar); border-accent-fg for a focused field"
    },
    "color-danger-fg": {
      "dark": "var(--color-rose-400)",
      "light": "var(--color-rose-700)",
      "note": "Destructive / error text on surfaces"
    },
    "color-success-fg": {
      "dark": "var(--color-emerald-400)",
      "light": "var(--color-emerald-700)",
      "note": "Success / online text on surfaces"
    },
    "color-warning-fg": {
      "dark": "var(--color-amber-400)",
      "light": "var(--color-amber-800)",
      "note": "Warning / pending text on surfaces (amber-700 was 4.35:1 on Soft / Sharp fields)"
    },
    "color-info-fg": {
      "dark": "var(--color-sky-400)",
      "light": "var(--color-sky-700)",
      "note": "Informational text on surfaces"
    },
    "color-tone-purple": {
      "dark": "var(--color-purple-300)",
      "light": "var(--color-purple-700)",
      "note": "Tonal purple text on tinted (bg-purple-500/10) or neutral surfaces"
    },
    "color-tone-violet": {
      "dark": "var(--color-violet-300)",
      "light": "var(--color-violet-700)",
      "note": "Tonal violet text on tinted (bg-violet-500/10) or neutral surfaces"
    },
    "color-tone-indigo": {
      "dark": "var(--color-indigo-300)",
      "light": "var(--color-indigo-700)",
      "note": "Tonal indigo text on tinted (bg-indigo-500/10) or neutral surfaces"
    },
    "color-tone-blue": {
      "dark": "var(--color-blue-300)",
      "light": "var(--color-blue-700)",
      "note": "Tonal blue text on tinted (bg-blue-500/10) or neutral surfaces"
    },
    "color-tone-sky": {
      "dark": "var(--color-sky-300)",
      "light": "var(--color-sky-700)",
      "note": "Tonal sky text on tinted (bg-sky-500/10) or neutral surfaces"
    },
    "color-tone-cyan": {
      "dark": "var(--color-cyan-300)",
      "light": "var(--color-cyan-800)",
      "note": "Tonal cyan text on tinted (bg-cyan-500/10) or neutral surfaces"
    },
    "color-tone-teal": {
      "dark": "var(--color-teal-300)",
      "light": "var(--color-teal-800)",
      "note": "Tonal teal text on tinted (bg-teal-500/10) or neutral surfaces"
    },
    "color-tone-emerald": {
      "dark": "var(--color-emerald-300)",
      "light": "var(--color-emerald-700)",
      "note": "Tonal emerald text on tinted (bg-emerald-500/10) or neutral surfaces"
    },
    "color-tone-amber": {
      "dark": "var(--color-amber-300)",
      "light": "var(--color-amber-800)",
      "note": "Tonal amber text on tinted (bg-amber-500/10) or neutral surfaces"
    },
    "color-tone-orange": {
      "dark": "var(--color-orange-300)",
      "light": "var(--color-orange-800)",
      "note": "Tonal orange text on tinted (bg-orange-500/10) or neutral surfaces"
    },
    "color-tone-rose": {
      "dark": "var(--color-rose-300)",
      "light": "var(--color-rose-700)",
      "note": "Tonal rose text on tinted (bg-rose-500/10) or neutral surfaces"
    },
    "color-tone-pink": {
      "dark": "var(--color-pink-300)",
      "light": "var(--color-pink-800)",
      "note": "Tonal pink text on tinted (bg-pink-500/10) or neutral surfaces"
    },
    "color-danger-bg": {
      "dark": "color-mix(in oklab, var(--color-rose-500) 12%, transparent)",
      "light": "color-mix(in oklab, var(--color-rose-500) 10%, transparent)",
      "note": "Tinted danger surface (callout, badge, danger button)"
    },
    "color-danger-border": {
      "dark": "color-mix(in oklab, var(--color-rose-500) 25%, transparent)",
      "light": "color-mix(in oklab, var(--color-rose-500) 30%, transparent)",
      "note": "Border of the tinted danger surface"
    },
    "color-danger-solid": {
      "dark": "var(--color-rose-500)",
      "light": "var(--color-rose-600)",
      "note": "Solid danger fill (status dot, progress, destructive confirm); text on it is on-solid"
    },
    "color-success-bg": {
      "dark": "color-mix(in oklab, var(--color-emerald-500) 12%, transparent)",
      "light": "color-mix(in oklab, var(--color-emerald-500) 10%, transparent)",
      "note": "Tinted success surface (callout, badge, danger button)"
    },
    "color-success-border": {
      "dark": "color-mix(in oklab, var(--color-emerald-500) 25%, transparent)",
      "light": "color-mix(in oklab, var(--color-emerald-500) 30%, transparent)",
      "note": "Border of the tinted success surface"
    },
    "color-success-solid": {
      "dark": "var(--color-emerald-500)",
      "light": "var(--color-emerald-600)",
      "note": "Solid success fill (status dot, progress, destructive confirm); text on it is on-solid"
    },
    "color-warning-bg": {
      "dark": "color-mix(in oklab, var(--color-amber-500) 12%, transparent)",
      "light": "color-mix(in oklab, var(--color-amber-500) 10%, transparent)",
      "note": "Tinted warning surface (callout, badge, danger button)"
    },
    "color-warning-border": {
      "dark": "color-mix(in oklab, var(--color-amber-500) 25%, transparent)",
      "light": "color-mix(in oklab, var(--color-amber-500) 30%, transparent)",
      "note": "Border of the tinted warning surface"
    },
    "color-warning-solid": {
      "dark": "var(--color-amber-500)",
      "light": "var(--color-amber-600)",
      "note": "Solid warning fill (status dot, progress, destructive confirm); text on it is on-solid"
    },
    "color-info-bg": {
      "dark": "color-mix(in oklab, var(--color-sky-500) 12%, transparent)",
      "light": "color-mix(in oklab, var(--color-sky-500) 10%, transparent)",
      "note": "Tinted info surface (callout, badge, danger button)"
    },
    "color-info-border": {
      "dark": "color-mix(in oklab, var(--color-sky-500) 25%, transparent)",
      "light": "color-mix(in oklab, var(--color-sky-500) 30%, transparent)",
      "note": "Border of the tinted info surface"
    },
    "color-info-solid": {
      "dark": "var(--color-sky-500)",
      "light": "var(--color-sky-600)",
      "note": "Solid info fill (status dot, progress, destructive confirm); text on it is on-solid"
    },
    "color-on-solid": {
      "dark": "#ffffff",
      "light": "#ffffff",
      "note": "Text on a *-solid fill"
    },
    "color-overlay": {
      "dark": "rgba(0, 0, 0, 0.7)",
      "light": "rgba(15, 23, 42, 0.4)",
      "note": "Backdrop behind modals, sheets and dialogs"
    },
    "shadow-overlay": {
      "dark": "0 24px 48px -12px rgb(0 0 0 / 0.6)",
      "light": "0 24px 48px -12px rgb(15 23 42 / 0.18)",
      "note": "Floating layers only: modal, popover, menu, toast"
    },
    "shadow-float": {
      "dark": "0 8px 24px -6px rgb(0 0 0 / 0.5)",
      "light": "0 8px 24px -6px rgb(15 23 42 / 0.12)",
      "note": "Controls floating over a canvas (VIEWPORT_*)"
    },
    "shadow-tint": {
      "dark": "rgb(0 0 0 / 0.35)",
      "light": "rgb(15 23 42 / 0.07)",
      "note": "Colour of style shadows (shadow-card in Soft); no utility",
      "private": true
    },
    "color-chart-1": {
      "dark": "#3987e5",
      "light": "#2a78d6",
      "note": "Chart series 1 (blue); fixed order, never cycled. Marks only, never text"
    },
    "color-chart-2": {
      "dark": "#d95926",
      "light": "#eb6834",
      "note": "Chart series 2 (orange); fixed order, never cycled. Marks only, never text"
    },
    "color-chart-3": {
      "dark": "#199e70",
      "light": "#1baf7a",
      "note": "Chart series 3 (aqua); fixed order, never cycled. Marks only, never text"
    },
    "color-chart-4": {
      "dark": "#c98500",
      "light": "#eda100",
