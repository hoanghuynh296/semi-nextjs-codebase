{
  "$note": "A Semi style: the look every component reads. tokens = shape, card border, fonts, control sizes; palettes = the colour variants of the style (the first is the default): each one's semantic = neutral surface / text / line colours per theme, overriding tokens/tokens.json (accent, status and tone colours stay shared). Every style sets the same token keys. fonts = what the app loads with next/font. Edit, then npm run build:tokens. docs/STYLES.md describes each style.",
  "name": "Flat",
  "default": true,
  "description": "Cool neutral greys, thin borders, no card shadows, medium radii, compact 34px controls, Geist. Dense, information-first screens: dashboards, tools, admin.",
  "fonts": [
    {
      "family": "Geist",
      "variable": "--font-geist",
      "nextFont": "Geist"
    },
    {
      "family": "Montserrat Alternates",
      "variable": "--font-montserrat-alternates",
      "nextFont": "Montserrat_Alternates",
      "weight": [
        "600",
        "700"
      ]
    }
  ],
  "tokens": {
    "radius-chip": {
      "value": "0.25rem",
      "note": "Small marks: checkboxes, inline code, count marks"
    },
    "radius-control": {
      "value": "0.5rem",
      "note": "Buttons, inputs, selects, tiles, list rows"
    },
    "radius-card": {
      "value": "0.75rem",
      "note": "Cards, popovers, menus, toasts"
    },
    "radius-panel": {
      "value": "1rem",
      "note": "Hero, modal, drawer, sheet, sidebar"
    },
    "shadow-card": {
      "value": "0 0 #0000",
      "note": "Resting card shadow"
    },
    "card-border": {
      "value": "1px solid var(--semi-line)",
      "note": "Card / hero / sidebar border (border-card)"
    },
    "font-sans": {
      "value": "var(--font-sans-family, var(--font-geist)), Geist, Inter, -apple-system, BlinkMacSystemFont, \"SF Pro Text\", sans-serif",
      "note": "UI and body text"
    },
    "font-display": {
      "value": "var(--font-display-family, var(--font-montserrat-alternates)), \"Montserrat Alternates\", var(--font-geist), sans-serif",
      "note": "Page titles, KPI figures"
    },
    "spacing-control": {
      "value": "34px",
      "note": "Toolbar controls: buttons, pills, chips, search (h-control, w-control)"
    },
    "spacing-field": {
      "value": "36px",
      "note": "Form inputs and selects (h-field)"
    }
  },
  "palettes": [
    {
      "id": "graphite",
      "name": "Graphite",
      "description": "Neutral cool grey (the original Semi look).",
      "semantic": {}
    },
    {
      "id": "slate",
      "name": "Slate",
      "description": "Blue-tinted greys: calm, technical.",
      "semantic": {
        "color-canvas": {
          "dark": "#0b0e14",
          "light": "#eef2f7"
        },
        "color-app": {
          "dark": "#10141c",
          "light": "#ffffff"
        },
        "color-panel": {
          "dark": "#161b25",
          "light": "#ffffff"
        },
        "color-field": {
          "dark": "#1c2230",
          "light": "#eef2f7"
        },
        "color-raised": {
          "dark": "#262d3d",
          "light": "#dde4ee"
        },
        "color-text-contrast": {
          "dark": "#f8fafc",
          "light": "#0f172a"
        },
        "color-text-body": {
          "dark": "#cbd5e1",
          "light": "#334155"
        },
        "color-text-muted": {
          "dark": "#8a96a8",
          "light": "#56637a"
        },
        "color-line": {
          "dark": "rgba(203, 213, 225, 0.09)",
          "light": "rgba(15, 23, 42, 0.09)"
        },
        "color-line-hover": {
          "dark": "rgba(203, 213, 225, 0.18)",
          "light": "rgba(15, 23, 42, 0.18)"
        },
        "color-divider": {
          "dark": "rgba(203, 213, 225, 0.06)",
          "light": "rgba(15, 23, 42, 0.06)"
        }
      }
    },
    {
