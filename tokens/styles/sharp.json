      "value": "0.125rem"
    },
    "radius-control": {
      "value": "0"
    },
    "radius-card": {
      "value": "0"
    },
    "radius-panel": {
      "value": "0"
    },
    "shadow-card": {
      "value": "4px 4px 0 var(--semi-line-hover)",
      "note": "Hard offset shadow in the strong line colour"
    },
    "card-border": {
      "value": "2px solid var(--semi-line-hover)"
    },
    "font-sans": {
