{
  "$note": "A Semi style: the look every component reads. tokens = shape, card border, fonts, control sizes; semantic = the neutral colours the style sets (both themes); omitted = the shared neutrals of tokens/tokens.json.",
  "name": "Sharp",
  "description": "Off-black ink and off-white, strong 2px borders, square corners, a hard offset shadow, Space Grotesk. Bold, editorial screens: landing pages, portfolios, creative tools.",
  "fonts": [
    {
      "family": "Space Grotesk",
      "variable": "--font-space-grotesk",
      "nextFont": "Space_Grotesk"
    }
  ],
  "tokens": {
    "radius-chip": {
      "value": "0.125rem"
    },
    "radius-control": {
      "value": "0"
    },
    "radius-card": {
      "value": "0"
    },
    "radius-panel": {
      "value": "0"
    },
    "shadow-card": {
      "value": "4px 4px 0 var(--semi-line-hover)",
      "note": "Hard offset shadow in the strong line colour"
    },
    "card-border": {
      "value": "2px solid var(--semi-line-hover)"
    },
    "font-sans": {
      "value": "var(--font-sans-family, var(--font-space-grotesk)), \"Space Grotesk\", -apple-system, BlinkMacSystemFont, \"SF Pro Text\", sans-serif"
    },
    "font-display": {
      "value": "var(--font-display-family, var(--font-space-grotesk)), \"Space Grotesk\", sans-serif"
    },
    "spacing-control": {
      "value": "36px"
    },
    "spacing-field": {
      "value": "40px"
    },
    "font-figure": {
      "value": "var(--semi-font-display)"
    },
    "font-weight-title": {
      "value": "700"
    },
    "spacing": {
      "value": "var(--density-spacing, 0.25rem)"
    }
  },
  "semantic": {
    "color-canvas": {
      "dark": "#0e0e0e",
      "light": "#f7f7f4"
    },
    "color-app": {
      "dark": "#121212",
      "light": "#fbfbf9"
    },
    "color-panel": {
      "dark": "#181818",
      "light": "#ffffff"
    },
    "color-field": {
      "dark": "#202020",
      "light": "#f0f0ec"
    },
    "color-raised": {
      "dark": "#2a2a2a",
      "light": "#e2e2dd"
    },
    "color-text-contrast": {
      "dark": "#f5f5f2",
      "light": "#141414"
    },
    "color-text-body": {
      "dark": "#d6d6d2",
      "light": "#333331"
    },
    "color-text-muted": {
      "dark": "#9a9a96",
      "light": "#5c5c58"
    },
    "color-line": {
      "dark": "rgba(245, 245, 242, 0.2)",
      "light": "rgba(20, 20, 20, 0.18)"
    },
    "color-line-hover": {
      "dark": "rgba(245, 245, 242, 0.55)",
      "light": "rgba(20, 20, 20, 0.7)"
    },
    "color-divider": {
      "dark": "rgba(245, 245, 242, 0.1)",
      "light": "rgba(20, 20, 20, 0.09)"
    }
