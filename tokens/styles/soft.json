{
  "$note": "A Semi style: the look every component reads. tokens = shape, card border, fonts, control sizes; palettes = the colour variants of the style (the first is the default): each one's semantic = neutral surface / text / line colours per theme, overriding tokens/tokens.json (accent, status and tone colours stay shared). Every style sets the same token keys. fonts = what the app loads with next/font. Edit, then npm run build:tokens. docs/STYLES.md describes each style.",
  "name": "Soft",
  "description": "Warm, tinted neutrals, borderless cards lifted by a soft shadow, large radii, roomy 40px controls, Plus Jakarta Sans. Calm, friendly screens: consumer apps, storefronts, onboarding.",
  "fonts": [
    {
      "family": "Plus Jakarta Sans",
      "variable": "--font-jakarta",
      "nextFont": "Plus_Jakarta_Sans"
    }
  ],
  "tokens": {
    "radius-chip": {
      "value": "0.375rem"
    },
    "radius-control": {
      "value": "0.75rem"
    },
    "radius-card": {
      "value": "1.25rem"
    },
    "radius-panel": {
      "value": "1.5rem"
    },
    "shadow-card": {
      "value": "0 1px 2px var(--semi-shadow-tint), 0 10px 28px -10px var(--semi-shadow-tint)"
    },
    "card-border": {
      "value": "1px solid transparent",
      "note": "No visible border: the fill and shadow separate cards (hover / active still colour it)"
    },
    "font-sans": {
      "value": "var(--font-sans-family, var(--font-jakarta)), \"Plus Jakarta Sans\", -apple-system, BlinkMacSystemFont, \"SF Pro Text\", sans-serif"
    },
    "font-display": {
      "value": "var(--font-display-family, var(--font-jakarta)), \"Plus Jakarta Sans\", sans-serif"
    },
    "spacing-control": {
      "value": "40px"
    },
    "spacing-field": {
      "value": "44px"
    }
  },
