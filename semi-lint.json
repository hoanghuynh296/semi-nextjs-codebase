{
  "scan": [
    "src",
    "styles",
    "app",
    "site",
    "examples"
  ],
  "baseline": "semi-lint-baseline.json",
  "skip": {
    "inline-svg-path": [
      "src/Chart.tsx",
      "src/Icon.tsx"
    ],
    "app-chrome-copy": [
      "styles/appChrome.ts"
    ],
    "legacy-ui-wrapper": [
      "src/"
    ],
    "loading-text": [
      "src/locale.tsx"
    ],
    "font-mono": [
      "site/",
      "src/CodeBlock.tsx"
    ],
    "thick-stroke": [
      "src/Chart.tsx"
    ]
  },
  "ignore": [
    "examples/registry.generated.ts"
  ]
}
