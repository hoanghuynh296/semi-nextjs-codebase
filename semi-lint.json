{
  "scan": [
    "src",
    "styles",
    "app",
    "site",
    "examples"
  ],
  "baseline": "semi-lint-baseline.json",
  "skip": {
    "no-literal-palette": {
      "src/QRCode.tsx": "machine-read symbol: print variant is black on white in both themes (scanners need dark-on-light)"
    },
    "inline-svg-path": {
      "src/Chart.tsx": "illustration: chart marks",
      "src/Icon.tsx": "illustration: the icon catalogue",
      "src/QRCode.tsx": "data: the QR modules are one machine-read path"
    },
    "app-chrome-copy": [
      "styles/appChrome.ts"
    ],
    "legacy-ui-wrapper": [
      "src/"
    ],
    "loading-text": [
      "src/locale.tsx"
    ],
    "font-mono": [
      "site/",
      "src/CodeBlock.tsx",
      "src/Terminal.tsx"
    ],
    "thick-stroke": [
      "src/Chart.tsx",
      "src/Agent.tsx"
    ],
    "raw-control": [
      "src/"
    ],
    "local-primitive": [
      "src/"
    ],
    "custom-overlay": [
      "src/",
      "styles/"
    ],
    "custom-spinner": [
      "src/"
    ],
    "leading-override": [
      "src/"
    ],
    "inline-style-value": {
      "src/Chart.tsx": "data colours: series colours of the chart",
      "app/brand/page.tsx": "data colours: the brand's swatches"
    }
  },
  "ignore": [
    "examples/registry.generated.ts",
    "site/foundations.generated.ts"
  ]
}
